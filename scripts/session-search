#!/bin/sh
set -eu
python=${SESSION_SEARCH_PYTHON:-"$HOME/.local/share/codex-session-index/venv/bin/python"}
if [ ! -x "$python" ]; then
    echo "session-search: Python environment unavailable: $python" >&2
    exit 1
fi
export PYTHONPATH="/usr/lib/session-search${PYTHONPATH:+:$PYTHONPATH}"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export PYTHONDONTWRITEBYTECODE=1
case "${1:-}" in
    tui) shift; exec "$python" -m session_search.tui "$@" ;;
    mcp) shift; exec "$python" -m session_search.server "$@" ;;
    index) shift; exec "$python" -m session_search.indexer "$@" ;;
    status)
        shift
        if [ "$#" -ne 0 ]; then echo 'Usage: session-search status' >&2; exit 2; fi
        exec "$python" -c 'import json; from session_search.indexer import request_index; print(json.dumps(request_index({"op": "status"}), ensure_ascii=False, indent=2))'
        ;;
    *) echo 'Usage: session-search mcp|index|status|tui' >&2; exit 2 ;;
esac
