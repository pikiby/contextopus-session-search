{
  "id": "session_search",
  "version": "0.9.0",
  "core_requires": ">=1.7,<2",
  "rag": true,
  "storage": {
    "engine": "sqlite",
    "schema_version": 2,
    "migrations": "migrations",
    "compatible_versions": {
      "min": 2,
      "max": 2
    }
  },
  "service": {
    "factory": "worker.py:create_service",
    "ready_timeout": 30,
    "stop_timeout": 10
  },
  "operations": [
    {
      "name": "session_search.status",
      "kind": "query",
      "service": true,
      "description": "Inspect session-card storage and pending indexing. Never starts transcript collection.",
      "timeout": 120,
      "arguments_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "session_search.save",
      "kind": "execute",
      "service": true,
      "description": "Create or update one Markdown session card. Existing cards require expected_revision. Save never reads or modifies the original conversation. Files survive indexing failure; retry reconcile.",
      "timeout": 120,
      "arguments_schema": {
        "type": "object",
        "properties": {
          "record": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "source_uri": {
                "type": "string"
              },
              "project": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "contexts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "links": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required_links": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "covered_through": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "description",
              "source",
              "session_id",
              "content"
            ]
          },
          "expected_revision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "record"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "session_search.read",
      "kind": "query",
      "service": true,
      "description": "Read one complete session description, metadata and links. Links do not inherit rules automatically.",
      "timeout": 120,
      "arguments_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "session_search.list",
      "kind": "query",
      "service": true,
      "description": "List session cards with metadata filters; no conversation text.",
      "timeout": 120,
      "arguments_schema": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "project": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "tag": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "session_search.search",
      "kind": "query",
      "service": true,
      "description": "Search card descriptions through shared Core RAG. Metadata filters and current file revisions restrict candidates before relevance selection. No transcript excerpts.",
      "timeout": 120,
      "arguments_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "project": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "tag": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "selection": {
            "type": "object"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "session_search.reconcile",
      "kind": "execute",
      "service": true,
      "description": "Reconcile Markdown additions, edits, moves and deletions into derived SQL and shared RAG. Does not read source sessions, generate summaries or run a background watcher.",
      "timeout": 120,
      "arguments_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "session_search.delete",
      "kind": "execute",
      "service": true,
      "description": "Delete only the selected session card at its current revision and reconcile its index. Never deletes the original session.",
      "timeout": 120,
      "arguments_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expected_revision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "expected_revision"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "session_search.library",
      "kind": "query",
      "service": true,
      "description": "Browse session cards through the shared web library. Source, project, context, tag and status filters work for text and semantic search.",
      "timeout": 120,
      "arguments_schema": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "collections",
              "records",
              "record"
            ]
          },
          "collection": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "text",
              "semantic"
            ]
          },
          "type": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "id": {
            "type": "string"
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "project": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "tag": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  ],
  "procedures": "procedures",
  "skills": "skills"
}
